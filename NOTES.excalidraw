      "boundElements": [],
      "updated": 1778554449769,
      "link": null,
      "locked": false,
      "text": "HTTP status codes:\n    *200--OK(success)\n    *201--created(new resourse made)\n    *301--moved(URL redirected)\n    *400--bad request (invalid request)\n    *401--unauthorised(need to login)\n    *403--forbidden(access denied)\n    *404--not found(page missing)\n    *500--server error(server crashed)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP status codes:\n    *200--OK(success)\n    *201--created(new resourse made)\n    *301--moved(URL redirected)\n    *400--bad request (invalid request)\n    *401--unauthorised(need to login)\n    *403--forbidden(access denied)\n    *404--not found(page missing)\n    *500--server error(server crashed)",
      "autoResize": false,
      "lineHeight": 1.25
    },
